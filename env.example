# Syndicate Transcript Backend - Auth service - port 8000
# DATABASE_URL: managed Postgres connection string (e.g. Aiven). SSL is required.
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=

# Generate: openssl rand -hex 32
JWT_SECRET=
# Session token lifetime in hours. Default: 24
JWT_EXPIRY_HOURS=24

# Comma-separated list of additional signing secrets this service will also accept
# on incoming Bearer tokens - e.g. tokens issued by the main Infollion platform
# during an SSO handoff (?auth_token= in the frontend URL). No live integration
# exists yet; leave empty until that platform side is coordinated.
JWT_TRUSTED_SECRETS=

# Comma-separated list of origins the browser is allowed to send requests from.
# Must match the URL the syndicate-client frontend is served at.
# Example: https://syndicate.infollion.com  or  http://localhost:5173 for local dev
CORS_ALLOWED_ORIGINS=

# Base URL of the frontend, used to build the password-reset link emailed to users.
# Example: https://syndicate.infollion.com  or  http://localhost:5173 for local dev
FRONTEND_BASE_URL=

# SMTP server used to send OTP and password-reset emails. If left empty, emails
# are logged instead of sent (useful for local dev without a real mailbox).
# Example (Gmail): SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USE_TLS=true,
# SMTP_USER=you@gmail.com, SMTP_PASS=<app password, not your account password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_USE_TLS=true

# Logging: level (DEBUG|INFO|WARNING|ERROR) and format (json for prod, console for dev)
LOG_LEVEL=INFO
LOG_FORMAT=console
